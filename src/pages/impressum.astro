---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Impressum | Schreinerei Huber"
  description="Impressum der Schreinerei Huber, Wolfratshausen. Angaben gemäß § 5 DDG."
>
  <section class="section">
    <div class="container prose">
      <h1>Impressum</h1>
      <p><mark class="placeholder">Platzhalter: Dies ist eine fiktive Testseite. Das Impressum muss vor einer echten Veröffentlichung mit den tatsächlichen Angaben des Unternehmens befüllt und rechtlich geprüft werden.</mark></p>

      <h2>Angaben gemäß § 5 DDG</h2>
      <p>
        {site.name}<br />
        Inhaber: {site.owner}<br />
        {site.address.street}<br />
        {site.address.zip} {site.address.city}
      </p>

      <h2>Kontakt</h2>
      <p>
        Telefon: {site.phoneDisplay}<br />
        E-Mail: {site.email}
      </p>

      <h2>Umsatzsteuer-ID</h2>
      <p>Umsatzsteuer-Identifikationsnummer gemäß § 27a UStG: <mark class="placeholder">[PLATZHALTER]</mark></p>

      <h2>Berufsbezeichnung und berufsrechtliche Regelungen</h2>
      <p>
        Berufsbezeichnung: Schreinermeister (verliehen in Deutschland)<br />
        Zuständige Kammer: <mark class="placeholder">[PLATZHALTER Handwerkskammer]</mark><br />
        Eintragung in die Handwerksrolle: <mark class="placeholder">[PLATZHALTER]</mark>
      </p>

      <h2>Verbraucherstreitbeilegung</h2>
      <p><mark class="placeholder">[PLATZHALTER: Hinweis zur Teilnahme an Streitbeilegungsverfahren]</mark></p>
    </div>
  </section>
</BaseLayout>
