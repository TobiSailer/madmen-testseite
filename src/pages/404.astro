---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Seite nicht gefunden | Schreinerei Huber" description="Diese Seite gibt es nicht oder nicht mehr.">
  <section class="section">
    <div class="container prose">
      <span class="eyebrow">Fehler 404</span>
      <h1>Diese Seite gibt es leider nicht</h1>
      <p class="lead">Vielleicht hat sich die Adresse geändert. Über die Startseite finden Sie alle Inhalte.</p>
      <p><a class="btn btn--primary" href="/">Zur Startseite</a></p>
    </div>
  </section>
</BaseLayout>
