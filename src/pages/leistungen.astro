---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ContactSection from '../components/ContactSection.astro';
import { getLeistungen } from '../lib/cms';

// Leistungen werden im CMS gepflegt (Keystatic: Leistungen)
const services = await getLeistungen();
---

<BaseLayout
  title="Leistungen: Möbel, Küchen, Innenausbau | Schreinerei Huber"
  description="Möbel nach Maß, Küchen, Innenausbau, Türen, Treppen und Reparaturen: die Leistungen der Schreinerei Huber in Wolfratshausen im Überblick."
>
  <Hero
    eyebrow="Leistungen"
    title="Schreinerarbeiten aus einer Hand"
    text="Wir übernehmen Planung, Fertigung und Montage. So haben Sie einen festen Ansprechpartner und keine Abstimmung zwischen verschiedenen Firmen."
    collage={services.slice(0, 3).map((s) => s.image)}
  />

  <section class="section">
    <div class="container">
      <nav class="jump" aria-label="Leistungen auf dieser Seite">
        {services.map((s) => <a href={`#${s.id}`}>{s.title}</a>)}
      </nav>

      <div class="services">
        {
          services.map((s) => (
            <article id={s.id} class="service">
              <img class="service__image" src={s.image} alt={s.imageAlt} width="1264" height="848" loading="lazy" decoding="async" />
              <div>
                <h2>{s.title}</h2>
                <p>{s.long}</p>
                {s.points.length > 0 && (
                  <ul>
                    {s.points.map((p) => <li>{p}</li>)}
                  </ul>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <ContactSection title="Ihr Projekt ist nicht dabei?" text="Viele Aufträge passen in keine Kategorie. Beschreiben Sie uns kurz, was Sie vorhaben, und wir sagen Ihnen offen, ob wir es umsetzen können." />
</BaseLayout>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 3rem;
  }

  .jump a {
    padding: 0.45rem 0.95rem;
    border: 1px solid var(--c-line);
    border-radius: 999px;
    background: var(--c-surface);
    color: var(--c-text);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
  }

  .jump a:hover {
    border-color: var(--c-accent);
    color: var(--c-accent);
  }

  .service {
    display: grid;
    grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 2.5rem);
    align-items: start;
    padding-block: 2.5rem;
    border-top: 1px solid var(--c-line);
    scroll-margin-top: 6rem;
    max-width: 60rem;
  }

  .service__image {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--c-surface-alt);
  }

  .service h2 {
    font-size: 1.75rem;
  }

  .service ul {
    margin: 0;
    padding-left: 1.2em;
    color: var(--c-muted);
  }

  @media (max-width: 40rem) {
    .service {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
