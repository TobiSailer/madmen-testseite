---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ContactSection from '../components/ContactSection.astro';
import { getUeberUns } from '../lib/cms';

// Inhalte werden im CMS gepflegt (Keystatic: Über uns)
const page = await getUeberUns();
---

<BaseLayout
  title="Über uns: Familienbetrieb seit 1987 | Schreinerei Huber"
  description="Die Schreinerei Huber ist ein Familienbetrieb aus Wolfratshausen. Erfahren Sie mehr über unsere Werkstatt, unser Team und wie wir arbeiten."
>
  <Hero eyebrow="Über uns" title={page.heroTitle} text={page.heroText} />

  <section class="section">
    <div class:list={['container', 'about', { 'about--no-facts': page.facts.length === 0 }]}>
      <div class="prose">
        {
          page.sections.map((s) => (
            <>
              <h2>{s.heading}</h2>
              {s.paragraphs.map((p) => <p>{p}</p>)}
            </>
          ))
        }
      </div>

      {
        page.facts.length > 0 && (
          <ul class="facts" aria-label="Zahlen zur Schreinerei">
            {page.facts.map((f) => (
              <li>
                <strong>{f.value}</strong>
                <span>{f.label}</span>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  {
    page.values.length > 0 && (
      <section class="section section--alt" aria-labelledby="werte-titel">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">Worauf wir Wert legen</span>
            <h2 id="werte-titel">{page.valuesTitle}</h2>
          </div>
          <div class="values">
            {page.values.map((v) => (
              <div class="value">
                <h3>{v.title}</h3>
                <p>{v.text}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <ContactSection />
</BaseLayout>

<style>
  .about {
    display: grid;
    grid-template-columns: 1fr 18rem;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .about--no-facts {
    grid-template-columns: 1fr;
  }

  .about .prose h2:first-child {
    margin-top: 0;
  }

  .facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .facts li {
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .facts strong {
    font-family: var(--f-head);
    font-size: 2.2rem;
    line-height: 1.1;
    color: var(--c-accent);
  }

  .facts span {
    color: var(--c-muted);
  }

  .values {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 2rem;
  }

  .value {
    border-top: 2px solid var(--c-accent);
    padding-top: 1.25rem;
  }

  .value p {
    color: var(--c-muted);
    margin: 0;
  }

  @media (max-width: 52rem) {
    .about {
      grid-template-columns: 1fr;
    }

    .facts {
      grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    }
  }
</style>
