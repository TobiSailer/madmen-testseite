---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ContactSection from '../components/ContactSection.astro';
import { site } from '../data/site';

const facts = [
  { value: site.founded, label: 'gegründet in Wolfratshausen' },
  { value: '8', label: 'Mitarbeitende in Werkstatt und Montage' },
  { value: '2', label: 'Auszubildende pro Jahrgang' },
];

const values = [
  {
    title: 'Holz aus der Region',
    text: 'Wo es möglich ist, verarbeiten wir Eiche, Buche und Fichte aus bayerischen Wäldern und kaufen bei Sägewerken in der Umgebung.',
  },
  {
    title: 'Klare Angebote',
    text: 'Sie bekommen ein Angebot, in dem jede Position nachvollziehbar ist. Ändert sich etwas, sprechen wir vorher mit Ihnen.',
  },
  {
    title: 'Ausbildung im Betrieb',
    text: 'Wir bilden jedes Jahr Schreinerinnen und Schreiner aus, weil wir gutes Handwerk auch in Zukunft in der Region halten wollen.',
  },
];
---

<BaseLayout
  title="Über uns: Familienbetrieb seit 1987 | Schreinerei Huber"
  description="Die Schreinerei Huber ist ein Familienbetrieb aus Wolfratshausen. Erfahren Sie mehr über unsere Werkstatt, unser Team und wie wir arbeiten."
>
  <Hero
    eyebrow="Über uns"
    title="Ein Familienbetrieb aus Wolfratshausen"
    text={`Die Schreinerei Huber wurde ${site.founded} gegründet und wird heute in zweiter Generation von ${site.owner} geführt.`}
  />

  <section class="section">
    <div class="container about">
      <div class="prose">
        <h2>Von der kleinen Werkstatt zum Meisterbetrieb</h2>
        <p>
          Angefangen hat alles mit einer Hobelbank in einer Garage. Heute arbeiten wir in einer eigenen Werkstatt mit moderner CNC-Technik und klassischen Maschinen. Die meisten Arbeitsschritte machen wir aber nach wie vor von Hand.
        </p>
        <p>
          Unsere Kundinnen und Kunden kommen überwiegend aus dem Landkreis Bad Tölz-Wolfratshausen und dem Raum Starnberg. Viele davon kennen uns über Empfehlungen, und viele kommen nach einigen Jahren mit dem nächsten Projekt wieder.
        </p>
        <h2>Wie wir arbeiten</h2>
        <p>
          Bevor wir etwas bauen, schauen wir uns den Raum an und hören zu. Daraus entsteht ein Entwurf, den wir mit Ihnen so lange abstimmen, bis er passt. Erst dann geht es in die Werkstatt.
        </p>
      </div>

      <ul class="facts" aria-label="Zahlen zur Schreinerei">
        {
          facts.map((f) => (
            <li>
              <strong>{f.value}</strong>
              <span>{f.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="werte-titel">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Worauf wir Wert legen</span>
        <h2 id="werte-titel">Drei Dinge, die uns wichtig sind</h2>
      </div>
      <div class="values">
        {
          values.map((v) => (
            <div class="value">
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <ContactSection />
</BaseLayout>

<style>
  .about {
    display: grid;
    grid-template-columns: 1fr 18rem;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .about .prose h2:first-child {
    margin-top: 0;
  }

  .facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .facts li {
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .facts strong {
    font-family: var(--f-head);
    font-size: 2.2rem;
    line-height: 1.1;
    color: var(--c-accent);
  }

  .facts span {
    color: var(--c-muted);
  }

  .values {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 2rem;
  }

  .value {
    border-top: 2px solid var(--c-accent);
    padding-top: 1.25rem;
  }

  .value p {
    color: var(--c-muted);
    margin: 0;
  }

  @media (max-width: 52rem) {
    .about {
      grid-template-columns: 1fr;
    }

    .facts {
      grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    }
  }
</style>
