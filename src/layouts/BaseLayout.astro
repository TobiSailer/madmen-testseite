---
// Rahmen für jede Seite: <head> mit SEO-Angaben, Header, Inhalt, Footer.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LocalBusinessSchema from '../components/LocalBusinessSchema.astro';
import { site } from '../data/site';

interface Props {
  title: string; // Seitentitel (ca. 50–60 Zeichen)
  description: string; // Meta-Description (ca. 140–160 Zeichen)
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Testseite: Suchmaschinen sollen nichts indexieren und keinen Links folgen -->
    <meta name="robots" content="noindex, nofollow" />

    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f7f3ed" />

    <!-- Vorschau beim Teilen (Open Graph) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <LocalBusinessSchema />
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    <Header />
    <main id="inhalt">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
  }

  .skip-link {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 100;
    background: var(--c-text);
    color: var(--c-bg);
    padding: 0.6rem 1rem;
    border-radius: var(--radius);
  }

  .skip-link:focus {
    top: 1rem;
  }
</style>
