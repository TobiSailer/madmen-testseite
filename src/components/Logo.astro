---
// Logo der Schreinerei Huber: ein "H" aus einer Holzverbindung
// (zwei Pfosten, verbunden durch einen Schmetterlings-Schwalbenschwanz)
// plus Wortmarke. Der Link-Text kommt vom umgebenden <a> (aria-label).
interface Props {
  tone?: 'light' | 'dark'; // dark = auf dunklem Grund (Footer)
  size?: 'md' | 'lg';
}

const { tone = 'light', size = 'md' } = Astro.props;
---

<span class:list={['brand', `brand--${tone}`, `brand--${size}`]}>
  <svg class="brand__mark" viewBox="0 0 40 40" aria-hidden="true">
    <rect class="brand__plate" width="40" height="40" rx="9"></rect>
    <g class="brand__joint">
      <rect x="8" y="7" width="6" height="26" rx="1"></rect>
      <rect x="26" y="7" width="6" height="26" rx="1"></rect>
      <path d="M14 17.5 L19.6 15 V25 L14 22.5 Z"></path>
      <path d="M26 17.5 L20.4 15 V25 L26 22.5 Z"></path>
    </g>
  </svg>
  <span class="brand__text" aria-hidden="true">
    <span class="brand__name">Huber</span>
    <span class="brand__sub">Schreinerei · seit 1987</span>
  </span>
</span>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .brand__mark {
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
  }

  .brand__plate {
    fill: var(--c-dark);
  }

  .brand__joint {
    fill: var(--c-brass);
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .brand__name {
    font-family: var(--f-head);
    font-weight: 600;
    font-size: 1.35rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-text);
  }

  .brand__sub {
    margin-top: 0.2rem;
    font-family: var(--f-body);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--c-accent);
    white-space: nowrap;
  }

  /* Footer: größer */
  .brand--lg .brand__mark {
    width: 3rem;
    height: 3rem;
  }

  .brand--lg .brand__name {
    font-size: 1.55rem;
  }

  .brand--lg .brand__sub {
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    white-space: normal; /* darf in schmalen Footer-Spalten umbrechen */
  }

  /* Auf dunklem Grund: Zeichen umgekehrt, Schrift hell */
  .brand--dark .brand__plate {
    fill: var(--c-brass);
  }

  .brand--dark .brand__joint {
    fill: var(--c-dark);
  }

  .brand--dark .brand__name {
    color: var(--c-on-dark);
  }

  .brand--dark .brand__sub {
    color: var(--c-brass);
  }

  @media (max-width: 30rem) {
    .brand--md {
      gap: 0.6rem;
    }

    .brand--md .brand__mark {
      width: 2.2rem;
      height: 2.2rem;
    }

    .brand--md .brand__name {
      font-size: 1.2rem;
    }

    .brand--md .brand__sub {
      font-size: 0.6rem;
      letter-spacing: 0.18em;
    }
  }
</style>
