---
// Großer Einstiegsbereich oben auf einer Seite.
// variant="home" zeigt zusätzlich die Holz-Grafik und Kennzahlen.
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  primary?: { href: string; label: string };
  secondary?: { href: string; label: string };
  variant?: 'home' | 'page';
}

const { eyebrow, title, text, primary, secondary, variant = 'page' } = Astro.props;
---

<section class:list={['hero', `hero--${variant}`]}>
  <div class="container hero__inner">
    <div class="hero__content">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h1>{title}</h1>
      {text && <p class="lead">{text}</p>}
      {
        (primary || secondary) && (
          <div class="hero__actions">
            {primary && <a class="btn btn--primary" href={primary.href}>{primary.label}</a>}
            {secondary && <a class="btn btn--ghost" href={secondary.href}>{secondary.label}</a>}
          </div>
        )
      }
      <slot />
    </div>

    {
      variant === 'home' && (
        <div class="hero__visual" aria-hidden="true">
          {/* Stilisierte Holzmaserung als Platzhalter für ein späteres Werkstattfoto */}
          <svg viewBox="0 0 400 480" preserveAspectRatio="xMidYMid slice">
            <defs>
              <linearGradient id="wood" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#b9824f" />
                <stop offset="1" stop-color="#8f5428" />
              </linearGradient>
            </defs>
            <rect width="400" height="480" fill="url(#wood)" />
            <g fill="none" stroke="#f7f3ed" stroke-opacity="0.18" stroke-width="2">
              <path d="M-20 60 C 80 20, 160 110, 260 70 S 420 40, 440 90" />
              <path d="M-20 110 C 90 70, 170 160, 270 120 S 420 90, 440 140" />
              <path d="M-20 165 C 100 125, 180 215, 280 175 S 420 145, 440 195" />
              <ellipse cx="210" cy="260" rx="46" ry="22" />
              <ellipse cx="210" cy="260" rx="78" ry="40" />
              <ellipse cx="210" cy="260" rx="112" ry="60" />
              <path d="M-20 340 C 90 300, 170 390, 270 350 S 420 320, 440 370" />
              <path d="M-20 395 C 100 355, 180 445, 280 405 S 420 375, 440 425" />
              <path d="M-20 450 C 110 410, 190 500, 290 460 S 420 430, 440 480" />
            </g>
          </svg>
          <p class="hero__badge">
            <strong>Seit 1987</strong>
            <span>Meisterbetrieb im Isartal</span>
          </p>
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .hero--page {
    padding-block: clamp(3rem, 7vw, 5rem) clamp(2rem, 5vw, 3rem);
    border-bottom: 1px solid var(--c-line);
  }

  .hero__inner {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero--home .hero__inner {
    grid-template-columns: 1.15fr 0.85fr;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero__visual {
    position: relative;
    aspect-ratio: 5 / 6;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .hero__visual svg {
    width: 100%;
    height: 100%;
  }

  .hero__badge {
    position: absolute;
    left: 1.25rem;
    bottom: 1.25rem;
    margin: 0;
    padding: 0.9rem 1.2rem;
    background: var(--c-surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .hero__badge strong {
    font-family: var(--f-head);
    font-size: 1.25rem;
  }

  .hero__badge span {
    font-size: 0.875rem;
    color: var(--c-muted);
  }

  @media (max-width: 52rem) {
    .hero--home .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero__visual {
      aspect-ratio: 16 / 10;
    }
  }
</style>
