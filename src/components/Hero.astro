---
// Großer Einstiegsbereich oben auf einer Seite.
// variant="home" zeigt zusätzlich die Holz-Grafik und Kennzahlen.
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  primary?: { href: string; label: string };
  secondary?: { href: string; label: string };
  variant?: 'home' | 'page';
  image?: { src: string; alt: string }; // nur bei variant="home"
}

const { eyebrow, title, text, primary, secondary, variant = 'page', image } = Astro.props;
---

<section class:list={['hero', `hero--${variant}`]}>
  <div class="container hero__inner">
    <div class="hero__content">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h1>{title}</h1>
      {text && <p class="lead">{text}</p>}
      {
        (primary || secondary) && (
          <div class="hero__actions">
            {primary && <a class="btn btn--primary" href={primary.href}>{primary.label}</a>}
            {secondary && <a class="btn btn--ghost" href={secondary.href}>{secondary.label}</a>}
          </div>
        )
      }
      <slot />
    </div>

    {
      variant === 'home' && image && (
        <div class="hero__visual">
          {/* Bild wird im CMS gepflegt (Keystatic: Startseite > Hero-Bild) */}
          <img src={image.src} alt={image.alt} width="1264" height="848" fetchpriority="high" decoding="async" />
          <p class="hero__badge" aria-hidden="true">
            <strong>Seit 1987</strong>
            <span>Meisterbetrieb im Isartal</span>
          </p>
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .hero--page {
    padding-block: clamp(3rem, 7vw, 5rem) clamp(2rem, 5vw, 3rem);
    border-bottom: 1px solid var(--c-line);
  }

  .hero__inner {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero--home .hero__inner {
    grid-template-columns: 1.15fr 0.85fr;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero__visual {
    position: relative;
    aspect-ratio: 5 / 6;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .hero__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Hochformat-Ausschnitt aus Querformat-Foto: Motiv sitzt rechts im Bild */
    object-position: 85% center;
  }

  .hero__badge {
    position: absolute;
    left: 1.25rem;
    bottom: 1.25rem;
    margin: 0;
    padding: 0.9rem 1.2rem;
    background: var(--c-surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .hero__badge strong {
    font-family: var(--f-head);
    font-size: 1.25rem;
  }

  .hero__badge span {
    font-size: 0.875rem;
    color: var(--c-muted);
  }

  @media (max-width: 52rem) {
    .hero--home .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero__visual {
      aspect-ratio: 16 / 10;
    }
  }
</style>
