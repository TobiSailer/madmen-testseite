---
// Vorschau-Karte für einen Ratgeber-Artikel.
import { formatDate, readingTime, type Post } from '../utils/ratgeber';

interface Props {
  post: Post;
  headingLevel?: 'h2' | 'h3';
}

const { post, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const href = `/ratgeber/${post.id}/`;
---

<article class="article-card">
  <div class="article-card__visual" aria-hidden="true">
    <svg viewBox="0 0 320 140" preserveAspectRatio="xMidYMid slice">
      <rect width="320" height="140" fill="#efe8de"></rect>
      <path d="M0 140 L0 40 L120 40 L220 140 Z" fill="#e2d8ca"></path>
      <path d="M0 40 L120 40 L220 140" fill="none" stroke="#8f5428" stroke-width="3"></path>
      <g fill="#8f5428" opacity="0.85">
        <rect x="20" y="58" width="26" height="74" rx="3"></rect>
        <rect x="52" y="58" width="26" height="74" rx="3"></rect>
        <rect x="84" y="58" width="26" height="74" rx="3"></rect>
        <rect x="128" y="94" width="40" height="16" rx="2"></rect>
        <rect x="128" y="114" width="40" height="16" rx="2"></rect>
      </g>
    </svg>
    <span class="article-card__cat">{post.data.category}</span>
  </div>
  <div class="article-card__body">
    <p class="article-card__meta">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      <span aria-hidden="true">·</span>
      <span>{readingTime(post.body)} Min. Lesezeit</span>
    </p>
    <Heading class="article-card__title">
      <a href={href}>{post.data.title}</a>
    </Heading>
    <p class="article-card__text">{post.data.description}</p>
    <span class="article-card__more" aria-hidden="true">Artikel lesen →</span>
  </div>
</article>

<style>
  .article-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    overflow: hidden;
    transition: box-shadow 0.2s;
  }

  .article-card:hover {
    box-shadow: var(--shadow);
  }

  .article-card__visual {
    position: relative;
    min-height: 12rem;
  }

  .article-card__visual svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .article-card__cat {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: var(--c-surface);
    color: var(--c-accent);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
  }

  .article-card__body {
    padding: clamp(1.5rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
  }

  .article-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.875rem;
    color: var(--c-muted);
    margin-bottom: 0.6rem;
  }

  .article-card__title {
    font-size: 1.45rem;
    margin-bottom: 0.6rem;
  }

  .article-card__title a {
    color: var(--c-text);
    text-decoration: none;
  }

  /* Ganze Karte klickbar */
  .article-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .article-card:hover .article-card__title a {
    color: var(--c-accent);
  }

  .article-card__text {
    color: var(--c-muted);
    flex: 1;
  }

  .article-card__more {
    font-weight: 600;
    color: var(--c-accent);
  }

  @media (max-width: 44rem) {
    .article-card {
      grid-template-columns: 1fr;
    }

    .article-card__visual {
      min-height: 9rem;
    }
  }
</style>
