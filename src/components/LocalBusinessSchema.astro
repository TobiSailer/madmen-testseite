---
// Strukturierte Daten nach Schema.org (LocalBusiness) als JSON-LD.
// Hilft Suchmaschinen und KI-Systemen, Firmenname, Adresse, Kontakt und
// Öffnungszeiten eindeutig zu verstehen. Kontaktdaten und Leistungen
// kommen aus dem CMS, feste Angaben aus src/data/site.ts.
import { site } from '../data/site';
import { getKontakt, getLeistungen } from '../lib/cms';

const [kontakt, leistungen] = await Promise.all([getKontakt(), getLeistungen()]);
const siteUrl = Astro.site?.toString() ?? '/';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${siteUrl}#business`,
  name: site.name,
  description: site.description,
  url: siteUrl,
  telephone: kontakt.phoneHref.replace('tel:', ''),
  email: kontakt.email,
  foundingDate: site.founded,
  priceRange: '€€',
  address: {
    '@type': 'PostalAddress',
    streetAddress: kontakt.street,
    postalCode: kontakt.zip,
    addressLocality: kontakt.city,
    addressRegion: site.region,
    addressCountry: site.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.geo.lat,
    longitude: site.geo.lng,
  },
  openingHoursSpecification: kontakt.hours.map((h) => h.schema),
  areaServed: site.serviceArea.map((name) => ({ '@type': 'City', name })),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Leistungen',
    itemListElement: leistungen.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.title, description: s.short },
    })),
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
