---
// Einfache Linien-Icons für die Leistungen, direkt als SVG (keine Icon-Dienste).
import type { Service } from '../data/site';

interface Props {
  name: Service['icon'];
}

const { name } = Astro.props;

const paths: Record<Service['icon'], string> = {
  furniture: 'M5 4h14v16H5zM12 4v16M9 12h1M14 12h1M5 20v1M19 20v1',
  kitchen: 'M3 10h18v10H3zM3 10V6h18v4M8 14h8M7 6V4M12 6V4M17 6V4',
  interior: 'M4 4v16M9 4v16M14 4v16M19 4v16M2 20h20',
  door: 'M6 21V3h12v18M3 21h18M15 12h.01',
  stairs: 'M3 20h5v-4h4v-4h4V8h5M3 20v-1',
  repair: 'M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4z',
};
---

<svg
  class="icon"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[name]}></path>
</svg>
