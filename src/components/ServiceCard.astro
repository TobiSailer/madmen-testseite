---
// Karte für eine Leistung. Wird auf Startseite und Leistungsseite genutzt.
import Icon from './Icon.astro';
import type { Service } from '../data/site';

interface Props {
  service: Service;
  link?: boolean; // true: Karte verlinkt auf den Abschnitt der Leistungsseite
}

const { service, link = true } = Astro.props;
---

<article class="card">
  <span class="card__icon"><Icon name={service.icon} /></span>
  <h3 class="card__title">{service.title}</h3>
  <p class="card__text">{service.short}</p>
  {
    link && (
      <a class="card__link" href={`/leistungen/#${service.id}`}>
        Mehr zu {service.title}
        <span aria-hidden="true">→</span>
      </a>
    )
  }
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    padding: 1.75rem;
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .card:hover {
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }

  .card__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 10px;
    background: var(--c-surface-alt);
    color: var(--c-accent);
    margin-bottom: 1.25rem;
  }

  .card__icon :global(.icon) {
    width: 1.6rem;
    height: 1.6rem;
  }

  .card__title {
    margin-bottom: 0.5rem;
  }

  .card__text {
    color: var(--c-muted);
    flex: 1;
  }

  .card__link {
    font-weight: 600;
    text-decoration: none;
  }

  /* Ganze Karte klickbar machen */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card:hover {
      transition: none;
      transform: none;
    }
  }
</style>
