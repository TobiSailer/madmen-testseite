---
// Karte für eine Leistung. Inhalte (Titel, Kurzbeschreibung, Bild) kommen aus dem CMS.
import type { Service } from '../lib/cms';

interface Props {
  service: Service;
  link?: boolean; // true: Karte verlinkt auf den Abschnitt der Leistungsseite
}

const { service, link = true } = Astro.props;
---

<article class="card">
  <img class="card__image" src={service.image} alt="" width="1264" height="848" loading="lazy" decoding="async" />
  <div class="card__body">
    <h3 class="card__title">{service.title}</h3>
    <p class="card__text">{service.short}</p>
    {
      link && (
        <a class="card__link" href={`/leistungen/#${service.id}`}>
          Mehr zu {service.title}
          <span aria-hidden="true">→</span>
        </a>
      )
    }
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    overflow: hidden;
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .card:hover {
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }

  .card__image {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: var(--c-surface-alt);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.5rem 1.75rem 1.75rem;
  }

  .card__title {
    margin-bottom: 0.5rem;
  }

  .card__text {
    color: var(--c-muted);
    flex: 1;
  }

  .card__link {
    font-weight: 600;
    text-decoration: none;
  }

  /* Ganze Karte klickbar machen */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card:hover {
      transition: none;
      transform: none;
    }
  }
</style>
