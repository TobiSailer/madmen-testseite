---
// Kontaktbereich mit Telefon, E-Mail, Adresse und Öffnungszeiten.
// Bewusst ohne Formular und ohne eingebettete Karte: beides würde externe
// Dienste oder einen Server brauchen. Kann später ergänzt werden.
import { site } from '../data/site';
import { getKontakt } from '../lib/cms';

const kontakt = await getKontakt();

interface Props {
  title?: string;
  text?: string;
  headingLevel?: 'h1' | 'h2';
}

const {
  title = 'Erzählen Sie uns von Ihrem Vorhaben',
  text = 'Rufen Sie an oder schreiben Sie uns eine E-Mail. Wir melden uns in der Regel innerhalb von zwei Werktagen und vereinbaren bei Bedarf einen Termin vor Ort.',
  headingLevel = 'h2',
} = Astro.props;

const Heading = headingLevel;
const tel = kontakt.phoneHref;
const mapsLink = `https://www.openstreetmap.org/?mlat=${site.geo.lat}&mlon=${site.geo.lng}#map=15/${site.geo.lat}/${site.geo.lng}`;
---

<section class="section contact" aria-labelledby="kontakt-titel">
  <div class="container contact__grid">
    <div>
      <span class="eyebrow">Kontakt</span>
      <Heading id="kontakt-titel">{title}</Heading>
      <p class="lead">{text}</p>
      <div class="contact__actions">
        <a class="btn btn--primary" href={tel}>Anrufen: {kontakt.phone}</a>
        <a class="btn btn--ghost" href={`mailto:${kontakt.email}`}>E-Mail schreiben</a>
      </div>
    </div>

    <div class="contact__box">
      <dl>
        <div>
          <dt>Adresse</dt>
          <dd>
            {site.name}<br />
            {kontakt.street}<br />
            {kontakt.zip} {kontakt.city}<br />
            <a href={mapsLink} rel="noopener">Auf OpenStreetMap ansehen</a>
          </dd>
        </div>
        <div>
          <dt>Telefon</dt>
          <dd><a href={tel}>{kontakt.phone}</a></dd>
        </div>
        <div>
          <dt>E-Mail</dt>
          <dd><a href={`mailto:${kontakt.email}`}>{kontakt.email}</a></dd>
        </div>
        <div>
          <dt>Öffnungszeiten</dt>
          <dd>
            {kontakt.hours.map((o) => <span class="hours">{o.days}: {o.time}</span>)}
            {kontakt.hoursNote && <span class="hours hours--note">{kontakt.hoursNote}</span>}
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--c-surface-alt);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .contact__box {
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    padding: clamp(1.5rem, 4vw, 2rem);
  }

  dl {
    margin: 0;
    display: grid;
    gap: 1.25rem;
  }

  dt {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-muted);
    margin-bottom: 0.25rem;
  }

  dd {
    margin: 0;
  }

  .hours {
    display: block;
  }

  .hours--note {
    color: var(--c-muted);
    font-size: 0.95rem;
    margin-top: 0.25rem;
  }

  @media (max-width: 52rem) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
