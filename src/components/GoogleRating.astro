---
// Google-Bewertung als Karte (Trust-Leiste) oder kompakte Zeile (Hero, Footer).
// Werte kommen aus src/data/trust.ts.
import { googleRating, formatScore } from '../data/trust';

interface Props {
  variant?: 'card' | 'inline';
  tone?: 'light' | 'dark';
}

const { variant = 'inline', tone = 'light' } = Astro.props;
const score = formatScore(googleRating.score);
const label = `${score} von 5 Sternen bei ${googleRating.count} Google-Bewertungen`;
const fullStars = Math.round(googleRating.score);
---

<div class:list={['grating', `grating--${variant}`, `grating--${tone}`]} role="img" aria-label={label}>
  <svg class="grating__logo" viewBox="0 0 48 48" aria-hidden="true">
    <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"></path>
    <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"></path>
    <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"></path>
    <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"></path>
  </svg>

  <div class="grating__body" aria-hidden="true">
    {variant === 'card' && <span class="grating__source">Google-Bewertungen</span>}
    <span class="grating__row">
      <strong class="grating__score">{score}</strong>
      <span class="grating__stars">
        {
          Array.from({ length: 5 }, (_, i) => (
            <svg viewBox="0 0 24 24" class:list={[i < fullStars ? 'is-on' : 'is-off']}>
              <path d="M12 2.5l2.94 6.08 6.56.95-4.75 4.63 1.12 6.54L12 17.6l-5.87 3.1 1.12-6.54L2.5 9.53l6.56-.95z"></path>
            </svg>
          ))
        }
      </span>
      {variant === 'inline' && <span class="grating__count">{googleRating.count} Google-Bewertungen</span>}
    </span>
    {variant === 'card' && <span class="grating__count">Basierend auf {googleRating.count} Bewertungen</span>}
  </div>
</div>

<style>
  .grating {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    line-height: 1.2;
  }

  .grating__logo {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
  }

  .grating__body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .grating__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .grating__score {
    font-weight: 700;
  }

  .grating__stars {
    display: inline-flex;
    gap: 1px;
  }

  .grating__stars svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  .grating__stars .is-on {
    fill: #fbbc04;
  }

  .grating__stars .is-off {
    fill: #dadce0;
  }

  .grating__count {
    font-size: 0.9rem;
    color: var(--c-muted);
  }

  /* Karte in der Trust-Leiste */
  .grating--card {
    align-items: flex-start;
    gap: 1rem;
    padding: 1.4rem 1.6rem;
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .grating--card .grating__logo {
    width: 2.4rem;
    height: 2.4rem;
  }

  .grating--card .grating__source {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-muted);
  }

  .grating--card .grating__score {
    font-family: var(--f-head);
    font-size: 2.4rem;
    font-weight: 600;
    line-height: 1;
  }

  .grating--card .grating__stars svg {
    width: 1.35rem;
    height: 1.35rem;
  }

  /* Auf dunklem Grund (Footer) */
  .grating--dark .grating__count {
    color: var(--c-on-dark);
    opacity: 0.8;
  }

  .grating--dark .grating__logo {
    background: #fff;
    border-radius: 50%;
    padding: 0.2rem;
    width: 1.75rem;
    height: 1.75rem;
  }
</style>
