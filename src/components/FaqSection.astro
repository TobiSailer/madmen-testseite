---
// FAQ als Aufklapp-Liste (funktioniert ohne JavaScript) plus Schema.org FAQPage.
import JsonLd from './JsonLd.astro';
import type { Faq } from '../data/faq';

interface Props {
  faqs: Faq[];
  title?: string;
  intro?: string;
}

const { faqs, title = 'Häufige Fragen', intro } = Astro.props;

const schema = {
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<section class="section faq" aria-labelledby="faq-titel">
  <div class="container faq__grid">
    <div class="faq__head">
      <span class="eyebrow">FAQ</span>
      <h2 id="faq-titel">{title}</h2>
      {intro && <p class="lead">{intro}</p>}
    </div>

    <div class="faq__list">
      {
        faqs.map((f, i) => (
          <details class="faq__item" open={i === 0}>
            <summary>
              <span>{f.question}</span>
              <span class="faq__icon" aria-hidden="true" />
            </summary>
            <p>{f.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
  <JsonLd data={schema} />
</section>

<style>
  .faq__grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .faq__head {
    position: sticky;
    top: 6.5rem;
  }

  .faq__list {
    border-top: 1px solid var(--c-line);
  }

  .faq__item {
    border-bottom: 1px solid var(--c-line);
  }

  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding: 1.25rem 0;
    font-weight: 600;
    font-size: 1.08rem;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    color: var(--c-accent);
  }

  .faq__icon {
    position: relative;
    flex-shrink: 0;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    border: 1px solid var(--c-line);
    background: var(--c-surface);
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.7rem;
    height: 2px;
    background: var(--c-accent);
    transform: translate(-50%, -50%);
    transition: transform 0.2s;
  }

  .faq__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .faq__item[open] .faq__icon::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .faq__item p {
    color: var(--c-muted);
    margin: 0;
    padding: 0 2.5rem 1.5rem 0;
  }

  @media (max-width: 52rem) {
    .faq__grid {
      grid-template-columns: 1fr;
    }

    .faq__head {
      position: static;
    }

    .faq__item p {
      padding-right: 0;
    }
  }
</style>
